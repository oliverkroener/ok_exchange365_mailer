# customsubcategory=cCredentials=Credentials
# customsubcategory=cEmail=Email Settings

# Empty values mean "not configured here" and fall back to the corresponding
# $GLOBALS['TYPO3_CONF_VARS']['MAIL']['transport_exchange365_*'] setting.

# cat=exchange365mailer/cCredentials/c0; type=string; label=Tenant ID: OAuth2 Tenant ID for connecting to Exchange365. Empty falls back to transport_exchange365_tenantId.
plugin.tx_okexchange365mailer.settings.exchange365.tenantId =

# cat=exchange365mailer/cCredentials/c1; type=string; label=Client ID: OAuth2 Client ID for connecting to Exchange365. Empty falls back to transport_exchange365_clientId.
plugin.tx_okexchange365mailer.settings.exchange365.clientId =

# cat=exchange365mailer/cCredentials/c2; type=string; label=Client Secret: OAuth2 Client Secret for connecting to Exchange365. Empty falls back to transport_exchange365_clientSecret.
plugin.tx_okexchange365mailer.settings.exchange365.clientSecret =

# cat=exchange365mailer/cEmail/e0; type=string; label=FromEmail: The Email used to send from Exchange365. Empty falls back to transport_exchange365_fromEmail.
plugin.tx_okexchange365mailer.settings.exchange365.fromEmail =

# cat=exchange365mailer/cEmail/e1; type=string; label=Graph Sender User ID: Optional Microsoft Graph mailbox/user ID used for the API call (Send As / Send On Behalf scenarios). Empty: the message From address, then fromEmail, then MAIL.defaultMailFromAddress.
plugin.tx_okexchange365mailer.settings.exchange365.graphSenderUserId =

# cat=exchange365mailer/cEmail/e2; type=select[0,1]; label=Save sent Emails: The Emails are saved to the Sent Folder if enabled
plugin.tx_okexchange365mailer.settings.exchange365.saveToSentItems = 1
