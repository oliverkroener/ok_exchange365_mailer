# Credentials for the OPT-IN live checks of the test matrix (make test-matrix-live).
#
#   mkdir -p ~/.config/ok-ex365
#   cp Build/testing/.env.test.dist ~/.config/ok-ex365/test.env
#   chmod 600 ~/.config/ok-ex365/test.env
#
# The file lives OUTSIDE the repository and outside everything that is mounted
# into the labs. Set OK_EX365_TEST_ENV to use another path. Use a TEST tenant and a
# TEST mailbox: a full run sends two real messages per TYPO3 major.
#
# Without this file (or without --live) the live rows report SKIPPED.

EXCHANGE365_TENANT_ID=00000000-0000-0000-0000-000000000000
EXCHANGE365_CLIENT_ID=00000000-0000-0000-0000-000000000000
EXCHANGE365_CLIENT_SECRET=your-client-secret-value
EXCHANGE365_FROM_EMAIL=service@example.org
# Optional: Graph mailbox for Send As / Send On Behalf (empty = the From address)
EXCHANGE365_GRAPH_SENDER_USER_ID=
# Optional: defaults to EXCHANGE365_FROM_EMAIL
EXCHANGE365_TEST_RECIPIENT=
