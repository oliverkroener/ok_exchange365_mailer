<?xml version="1.0" encoding="UTF-8"?>
<!--
    Functional test suite for ok_exchange365_mailer.

    The database credentials are DDEV defaults and are declared WITHOUT force="true",
    so a real environment variable always wins.

    root/root is not laziness: typo3/testing-framework creates and drops one database
    per parallel worker (<name>_ft1, _ft2, ...), and DDEV's default `db` user has no
    CREATE DATABASE grant.
-->
<phpunit
    bootstrap="bootstrap.php"
    cacheResult="false"
    colors="true"
    backupGlobals="true"
    failOnRisky="true"
    failOnWarning="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
>
    <php>
        <env name="OK_EXCHANGE365_TEST_SUITE" value="Functional"/>
        <env name="typo3DatabaseDriver" value="pdo_mysql"/>
        <env name="typo3DatabaseHost" value="db"/>
        <env name="typo3DatabasePort" value="3306"/>
        <env name="typo3DatabaseName" value="t3func"/>
        <env name="typo3DatabaseUsername" value="root"/>
        <env name="typo3DatabasePassword" value="root"/>
    </php>
    <testsuites>
        <testsuite name="ok_exchange365_mailer functional tests">
            <directory>../../Tests/Functional/</directory>
        </testsuite>
    </testsuites>
</phpunit>
