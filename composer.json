{
    "name": "oliverkroener/ok-exchange365-mailer",
    "description": "A TYPO3 extension for sending emails using Exchange 365 and Microsoft Graph API",
    "homepage": "https://www.oliver-kroener.de",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "version": "4.3.0",
    "authors": [
        {
            "name": "Oliver Kroener",
            "email": "ok@oliver-kroener.de"
        }
    ],
    "require": {
        "php": ">=8.1.0 <8.6.0",
        "typo3/cms-core": "^12.4 || ^13 || ^14",
        "oliverkroener/ok-typo3-helper": "^3",
        "microsoft/microsoft-graph": "^2"
    },
    "keywords": [
        "typo3",
        "typo3-extension",
        "email",
        "mailer",
        "exchange-365",
        "microsoft-graph",
        "oauth2",
        "office-365",
        "smtp-replacement"
    ],
    "autoload": {
        "psr-4": {
            "OliverKroener\\OkExchange365\\": "Classes/"
        }
    },
    "support": {
        "issues": "https://github.com/oliverkroener/ok_exchange365_mailer/issues",
        "source": "https://github.com/oliverkroener/ok_exchange365_mailer",
        "docs": "https://docs.typo3.org/p/oliverkroener/ok-exchange365-mailer/main/en-us/",
        "forum": "https://github.com/oliverkroener/ok_exchange365_mailer/discussions"
    },
    "require-dev": {
        "typo3/testing-framework": "^8.3.3 || ^9.1",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "suggest": {
        "typo3/cms-lowlevel": "Blinds the Exchange 365 credentials in the backend Configuration module."
    },
    "autoload-dev": {
        "psr-4": {
            "OliverKroener\\OkExchange365\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test:unit": "phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
        "test:matrix": "Build/Scripts/runTests.sh"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ok_exchange365_mailer"
        }
    }
}
