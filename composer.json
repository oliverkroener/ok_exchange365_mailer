{
    "name": "oliverkroener/ok-exchange365-mailer",
    "description": "A TYPO3 extension for sending emails using Exchange 365 and Microsoft Graph API",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "version": "1.0.2",
    "authors": [
        {
            "name": "Oliver Kröner",
            "email": "ok@oliver-kroener.de"
        }
    ],
    "require": {
        "php": ">=7.2",
        "typo3/cms-core": "^9.5",
        "oliverkroener/ok-typo3-helper": "^1",
        "guzzlehttp/guzzle": "^6.3 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "OliverKroener\\OkExchange365\\": "Classes/"
        }
    },
    "require-dev": {
        "typo3/testing-framework": "^4.15",
        "phpunit/phpunit": "^7.5"
    },
    "autoload-dev": {
        "psr-4": {
            "OliverKroener\\OkExchange365\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test:unit": "phpunit -c Build/phpunit/UnitTests.xml"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ok_exchange365_mailer"
        }
    }
}
